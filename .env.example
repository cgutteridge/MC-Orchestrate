#
# Direct OpenAI (takes precedence if both OpenAI and Azure env sets are present)
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_TIMEOUT_MS=1200000

#
# Azure OpenAI
#
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_POLICY_ID=
# Single chat completion timeout (ms). Default 900000 (15 min). Max 3600000.
# AZURE_OPENAI_CHAT_TIMEOUT_MS=1200000
# Use SSE streaming (default true) so HTTP headers return before the full completion is buffered.
# AZURE_OPENAI_CHAT_STREAM=false
# Prefer Responses API POST .../openai/v1/responses (default true). Set false to use Chat Completions only.
# AZURE_OPENAI_USE_RESPONSES=false
# api-version for Responses (Azure often needs preview).
# AZURE_OPENAI_RESPONSES_API_VERSION=preview
# Log request timings to stderr (status after headers, body size after download).
# MCORCH_AI_CHAT_DEBUG=1

#
# Shared app config
#
MCORCH_HOST=127.0.0.1
MCORCH_PORT=7070
MCORCH_HTTP_HOST=127.0.0.1
MCORCH_HTTP_PORT=7071
MINECRAFT_DIR=minecraft-server
MINECRAFT_JAR=spigot-1.21.1.jar
JAVA_BIN=/opt/homebrew/opt/openjdk@21/bin/java
MCORCH_ACTION_LOG=logs/bridge-actions.jsonl
MCORCH_AI_LOG=logs/ai-planner.jsonl
MCORCH_AI_PROVIDER_LOG=logs/ai-provider.log
# Placement-then-build: human-readable AI progress + max AI calls per request (placement + build + retries).
MCORCH_AI_PLAN_LOG=logs/ai-plan.log
MCORCH_AI_PLAN_MAX_STEPS=10
