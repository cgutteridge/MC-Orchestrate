{
  "name": "minecraftorchestrate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minecraft bridge, AI orchestrator, and Spigot plugin integration for in-game building commands.",
  "main": "dist/index.js",
  "scripts": {
    "start": "MCORCH_FULL_LOGGING=1 tsx src/index.ts",
    "smoke:ai": "tsx scripts/smoke-ai-connection.ts",
    "smoke:ai:prompt": "tsx scripts/smoke-ai-prompt.ts",
    "smoke:ai:placement": "tsx scripts/smoke-ai-placement.ts",
    "smoke:ai:design": "tsx scripts/smoke-ai-design.ts",
    "smoke:ai:build": "tsx scripts/smoke-ai-build.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "generate:blocks": "tsx scripts/generate-minecraft-block-ids.ts",
    "benchmark": "tsx src/benchmark/cli.ts",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "test:agent:watch": "vitest --config vitest.agent.config.ts",
    "plugin:build": "sh ./spigot-build/apache-maven-3.9.6/bin/mvn -Dmaven.repo.local=.m2/repository -f spigot-plugin/pom.xml package",
    "plugin:copy": "cp spigot-plugin/target/mc-orchestrate-plugin-1.0.0.jar minecraft-server/plugins/",
    "plugin:install": "npm run plugin:build && npm run plugin:copy"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "prismarine-chunk": "^1.39.0",
    "prismarine-nbt": "^2.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "knip": "^5.88.1",
    "minecraft-data": "^3.105.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.0.18"
  }
}
